{
  "name": "pdf-to-epub-tool",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "postinstall": "cp -r node_modules/tinymce public/tinymce 2>/dev/null || true",
    "dev": "vite",
    "dev:full": "concurrently -n front,api -c cyan,yellow \"bun run dev\" \"bun run server:dev\"",
    "build": "tsc && vite build",
    "build:bun": "bun run scripts/build.ts",
    "lint": "eslint .",
    "preview": "vite preview",
    "server": "bun server.js",
    "server:dev": "bun --watch server.js",
    "server:lt": "LANGUAGETOOL_URL=http://localhost:8010 bun --watch server.js",
    "languagetool": "bash scripts/start-languagetool.sh",
    "dev:lt": "concurrently -n lt,api,front -c magenta,yellow,cyan \"bun run languagetool\" \"bun run server:lt\" \"bun run dev\""
  },
  "dependencies": {
    "@codemirror/lang-css": "^6.3.1",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/react-query": "^5.102.3",
    "@tanstack/react-query-devtools": "^5.102.3",
    "@tinymce/tinymce-react": "^6.3.0",
    "@uiw/react-codemirror": "^4.25.11",
    "axios": "^1.19.0",
    "concurrently": "^9.2.4",
    "dompurify": "^3.4.11",
    "fflate": "^0.8.3",
    "file-saver": "^2.0.5",
    "jose": "^6.2.10",
    "jszip": "^3.10.1",
    "lucide-react": "^0.562.0",
    "mammoth": "^1.12.1",
    "pdfjs-dist": "^5.7.284",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-image-crop": "^11.1.2",
    "react-router-dom": "^7.18.2",
    "react-virtuoso": "^4.18.12",
    "sharp": "^0.34.5",
    "tinymce": "^8.8.2"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/file-saver": "^2.0.7",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@vitejs/plugin-react": "^5.2.0",
    "autoprefixer": "^10.5.4",
    "bun-types": "^1.4.0",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.4.26",
    "globals": "^16.5.0",
    "happy-dom": "^20.11.6",
    "postcss": "^8.5.26",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.68.0",
    "vite": "^7.3.6"
  }
}
