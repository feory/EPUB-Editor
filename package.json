{
  "name": "pdf-to-epub-tool",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "postinstall": "cp -r node_modules/tinymce public/tinymce 2>/dev/null || true",
    "dev": "vite",
    "dev:full": "concurrently -n front,api -c cyan,yellow \"bun run dev\" \"bun run server:dev\"",
    "build": "tsc && vite build",
    "build:bun": "bun run scripts/build.ts",
    "lint": "eslint .",
    "preview": "vite preview",
    "server": "bun server.js",
    "server:dev": "bun --watch server.js",
    "server:lt": "LANGUAGETOOL_URL=http://localhost:8010 bun --watch server.js",
    "languagetool": "bash scripts/start-languagetool.sh",
    "dev:lt": "concurrently -n lt,api,front -c magenta,yellow,cyan \"bun run languagetool\" \"bun run server:lt\" \"bun run dev\""
  },
  "dependencies": {
    "@codemirror/lang-css": "^6.3.1",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/react-query": "^5.103.0",
    "@tanstack/react-query-devtools": "^5.103.0",
    "@tinymce/tinymce-react": "^6.3.0",
    "@uiw/react-codemirror": "^4.25.11",
    "axios": "^1.20.0",
    "concurrently": "^10.0.5",
    "dompurify": "^3.4.15",
    "fflate": "^0.8.3",
    "file-saver": "^2.0.5",
    "jose": "^6.2.12",
    "jszip": "^3.10.2",
    "lucide-react": "^1.46.0",
    "mammoth": "^1.12.3",
    "pdfjs-dist": "^6.3.289",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-image-crop": "^11.1.2",
    "react-router-dom": "^7.18.4",
    "react-virtuoso": "^4.18.13",
    "sharp": "^0.35.4",
    "tinymce": "^8.9.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/file-saver": "^2.0.7",
    "@types/node": "^24.13.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.2.0",
    "autoprefixer": "^10.6.1",
    "bun-types": "^1.4.2",
    "eslint": "^10.10.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.12.0",
    "happy-dom": "^20.14.5",
    "postcss": "^8.5.28",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.70.0",
    "vite": "^7.3.6"
  }
}
